---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const { title = "Пластический хирург" } = Astro.props;
const locale = Astro.currentLocale || 'ru';

const menuItems = {
  ru: [
    { label: 'Главная', href: '/ru/' },
    { label: 'Услуги', href: '/ru/services' },
    { label: 'Блог', href: '/ru/blog' },
    { label: 'Отзывы', href: '/ru/reviews' },
    { label: 'О докторе', href: '/ru/about' },
  ],
  en: [
    { label: 'Home', href: '/en/' },
    { label: 'Services', href: '/en/services' },
    { label: 'Blog', href: '/en/blog' },
    { label: 'Reviews', href: '/en/reviews' },
    { label: 'About', href: '/en/about' },
  ],
};
const items = menuItems[locale] || menuItems.ru;

const footerData = {
  ru: {
    mapPlaceholder: "[ МЕСТО ДЛЯ КАРТЫ ]",
    copyright: "© 2026 Все права защищены.",
    moscowTitle: "Принимаю в Москве",
    moscowClinic: "Юсуповская больница",
    moscowAddress: "Нагорная улица, 17к6",
    uzbekistanTitle: "Филиал в Узбекистане",
    uzbekistanAddress: "г. Бухара, ул. Абу Хавзи Кабир, 2 (Цитадель Арк)",
    btnMoscow: "Москва (РФ)",
    btnUzbekistan: "Узбекистан",
    contactsTitle: "Связаться со мной",
    email: "red.ru.office@gmail.com",
  },
  en: {
    mapPlaceholder: "[ MAP PLACEHOLDER ]",
    copyright: "© 2026 All rights reserved.",
    moscowTitle: "Practicing in Moscow",
    moscowClinic: "Usupov Hospital",
    moscowAddress: "Nagornaya Street, 17k6",
    uzbekistanTitle: "Branch in Uzbekistan",
    uzbekistanAddress: "Bukhara, Abu Havzi Kabir St., 2 (Ark Citadel)",
    btnMoscow: "Moscow (RF)",
    btnUzbekistan: "Uzbekistan",
    contactsTitle: "Contact Me",
    email: "red.ru.office@gmail.com",
  }
};
const fData = footerData[locale] || footerData.ru;
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="font-sans text-gray-800 bg-gray-50 flex flex-col min-h-screen">
		
		<!-- ================= DESKTOP HEADER ================= -->
		<header class="hidden md:flex bg-slate-900 text-white py-4 justify-center items-center gap-10 sticky top-0 z-40 shadow-md relative">
			<nav class="flex gap-10">
				{items.map(item => (
					<a href={item.href} class="hover:text-blue-400 transition font-medium">{item.label}</a>
				))}
			</nav>
			<div class="absolute right-4 top-1/2 -translate-y-1/2">
				<LanguageSwitcher />
			</div>
		</header>

		<!-- ================= MOBILE HEADER ================= -->
		<header class="flex md:hidden bg-white p-4 items-center justify-between shadow-sm sticky top-0 z-40">
			<button id="burger-btn" class="text-slate-900 focus:outline-none">
				<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			<div class="bg-slate-800 rounded-lg p-1">
				<LanguageSwitcher />
			</div>
		</header>

		<!-- ================= MOBILE SLIDE-OUT MENU ================= -->
		<div id="mobile-overlay" class="fixed inset-0 bg-black/60 z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"></div>
		<div id="mobile-panel" class="fixed top-0 left-0 h-full w-[260px] bg-slate-900 text-white z-50 transform -translate-x-full transition-transform duration-300 flex flex-col items-center pt-20 md:hidden shadow-2xl">
			<button id="close-btn" class="absolute top-4 right-4 text-gray-400 hover:text-white text-3xl leading-none">&times;</button>
			{items.map(item => (
				<a href={item.href} class="w-full text-center py-4 text-lg hover:bg-slate-800 transition">{item.label}</a>
			))}
		</div>

		<!-- ================= MAIN CONTENT ================= -->
		<main class="max-w-6xl mx-auto px-4 py-8 w-full flex-grow">
			<slot />
		</main>

		<!-- ================= FOOTER ================= -->
		<footer class="bg-slate-800 text-slate-300 mt-auto">
			<div class="max-w-6xl mx-auto px-4 pt-12 pb-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
				
				<!-- Блок с картами (7 колонок) -->
				<div class="lg:col-span-7 w-full">
					<div class="flex gap-2 mb-3">
						<button id="btn-moscow" class="px-4 py-2 rounded text-sm font-medium transition bg-slate-600 text-white shadow-sm">
							{fData.btnMoscow}
						</button>
						<button id="btn-uzbekistan" class="px-4 py-2 rounded text-sm font-medium transition bg-slate-700 text-slate-300 hover:bg-slate-600 shadow-sm">
							{fData.btnUzbekistan}
						</button>
					</div>

					<div class="w-full h-64 md:h-96 rounded-lg overflow-hidden shadow-inner relative bg-slate-700">
						<div class="absolute inset-0 flex items-center justify-center text-slate-300 font-bold text-lg z-0">
							{fData.mapPlaceholder}
						</div>
						<iframe 
							id="map-moscow"
							src="https://yandex.ru/map-widget/v1/?um=constructor%3Ab40ae5a4c4c6221d4f93fc1eff8a979a9e1d7a1afbe73f1e550bb5d90db37be8&source=constructor"
							width="100%" height="100%" frameborder="0" allowfullscreen="true" class="absolute inset-0 z-10"
						></iframe>
						<iframe 
							id="map-uzbekistan"
							src="https://yandex.ru/map-widget/v1/?um=constructor%3Aaf7aca553451778a30c5c47ef3bbb11b52fbdc1d8ad3d4ca2559a8130fceeb8f&source=constructor"
							width="100%" height="100%" frameborder="0" allowfullscreen="true" class="absolute inset-0 z-10 hidden"
						></iframe>
					</div>
				</div>

				<!-- Текстовая часть (5 колонок) -->
				<div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm">
					
					<!-- Столбец 1: Адреса -->
					<div class="space-y-6">
						<div>
							<p class="text-white font-bold mb-1">{fData.moscowTitle}</p>
							<p>{fData.moscowClinic}</p>
							<p>{fData.moscowAddress}</p>
						</div>
						<div>
							<p class="text-white font-bold mb-1">{fData.uzbekistanTitle}</p>
							<p>{fData.uzbekistanAddress}</p>
						</div>
					</div>

					<!-- Столбец 2: Контакты и Соцсети -->
					<div class="space-y-4">
						<p class="text-white font-bold mb-4">{fData.contactsTitle}</p>
						
						<div class="flex flex-col space-y-2 mb-4">
							<a href="tel:88005553535" class="hover:text-white transition font-medium text-base">8 800 555-35-35</a>
							<a href="tel:89177171717" class="hover:text-white transition font-medium text-base">8 917 717-17-17</a>
							<a href={`mailto:${fData.email}`} class="hover:text-white transition text-sm text-slate-400 break-all">{fData.email}</a>
						</div>

						<div class="flex flex-col space-y-3">
							<a href="https://t.me/agdezia" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition group">
								<div class="bg-slate-700 p-2 rounded-lg group-hover:bg-blue-500 transition">
									<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
									</svg>
								</div>
								<span>@agdezia</span>
							</a>
							
							<a href="https://instagram.com/a.gdezia" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition group">
								<div class="bg-slate-700 p-2 rounded-lg group-hover:bg-pink-600 transition">
									<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
									</svg>
								</div>
								<span>@a.gdezia</span>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Копирайт -->
			<div class="border-t border-slate-700/50 py-6 text-center text-xs text-slate-500">
				<p>{fData.copyright}</p>
			</div>
		</footer>

		<!-- Кнопка "Наверх" -->
		<button id="scroll-to-top" class="fixed bottom-6 right-6 p-3 rounded-full bg-slate-900 text-white shadow-lg opacity-0 pointer-events-none transition-all duration-300 z-50 focus:outline-none hover:bg-slate-700 hover:-translate-y-1">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
			</svg>
		</button>

		<!-- ================= SCRIPTS ================= -->
		<script>
			const burgerBtn = document.getElementById('burger-btn');
			const closeBtn = document.getElementById('close-btn');
			const mobilePanel = document.getElementById('mobile-panel');
			const overlay = document.getElementById('mobile-overlay');

			burgerBtn?.addEventListener('click', () => {
				mobilePanel?.classList.remove('-translate-x-full');
				overlay?.classList.remove('hidden');
				setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
			});

			closeBtn?.addEventListener('click', closeMenu);
			overlay?.addEventListener('click', closeMenu);

			function closeMenu() {
				mobilePanel?.classList.add('-translate-x-full');
				overlay?.classList.add('opacity-0');
				setTimeout(() => overlay?.classList.add('hidden'), 300);
			}

			const btnMoscow = document.getElementById('btn-moscow');
			const btnUzbekistan = document.getElementById('btn-uzbekistan');
			const mapMoscow = document.getElementById('map-moscow');
			const mapUzbekistan = document.getElementById('map-uzbekistan');

			btnMoscow?.addEventListener('click', () => {
				mapMoscow?.classList.remove('hidden');
				mapUzbekistan?.classList.add('hidden');
				btnMoscow.classList.add('bg-slate-600', 'text-white');
				btnMoscow.classList.remove('bg-slate-700', 'text-slate-300');
				btnUzbekistan?.classList.add('bg-slate-700', 'text-slate-300');
				btnUzbekistan?.classList.remove('bg-slate-600', 'text-white');
			});

			btnUzbekistan?.addEventListener('click', () => {
				mapUzbekistan?.classList.remove('hidden');
				mapMoscow?.classList.add('hidden');
				btnUzbekistan.classList.add('bg-slate-600', 'text-white');
				btnUzbekistan.classList.remove('bg-slate-700', 'text-slate-300');
				btnMoscow?.classList.add('bg-slate-700', 'text-slate-300');
				btnMoscow?.classList.remove('bg-slate-600', 'text-white');
			});

			const scrollToTopBtn = document.getElementById('scroll-to-top');
			
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					scrollToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
					scrollToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
				} else {
					scrollToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
					scrollToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
				}
			});

			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		</script>
	</body>
</html>