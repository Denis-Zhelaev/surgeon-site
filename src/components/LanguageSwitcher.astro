---
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLocale = Astro.currentLocale || 'ru';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// 1. Безопасно убираем base из текущего пути (чтобы не было двойных слэшей)
let cleanPath = currentPath;
if (base !== '/') {
    // Убираем слэш в конце base, если он есть
    const baseWithoutTrailingSlash = base.replace(/\/$/, '');
    cleanPath = cleanPath.replace(baseWithoutTrailingSlash, '');
}

// 2. Убеждаемся, что путь начинается со слэша
if (!cleanPath.startsWith('/')) {
    cleanPath = '/' + cleanPath;
}

// 3. Отрезаем текущий язык (ru или en)
let pathWithoutLocale = cleanPath.replace(/^\/(ru|en)/, '');

// 4. Если путь пустой, ставим корень
if (!pathWithoutLocale) {
    pathWithoutLocale = '/';
}

// 5. Генерируем ссылки через встроенную функцию Astro
const ruUrl = getRelativeLocaleUrl('ru', pathWithoutLocale);
const enUrl = getRelativeLocaleUrl('en', pathWithoutLocale);
---

<div class="flex items-center gap-1">
  <a 
    href={ruUrl} 
    class:list={[
      "px-2 py-1 rounded text-sm font-medium transition",
      currentLocale === 'ru' ? 'bg-white/20 text-white' : 'text-slate-300 hover:text-white'
    ]}
  >RU</a>
  <a 
    href={enUrl} 
    class:list={[
      "px-2 py-1 rounded text-sm font-medium transition",
      currentLocale === 'en' ? 'bg-white/20 text-white' : 'text-slate-300 hover:text-white'
    ]}
  >EN</a>
</div>