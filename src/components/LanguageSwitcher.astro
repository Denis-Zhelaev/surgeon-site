---
const currentLocale = Astro.currentLocale || 'ru';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Убираем слэш в конце base, если он есть (например, /surgeon-site/ -> /surgeon-site)
const basePrefix = base === '/' ? '' : base.replace(/\/$/, '');

// Получаем путь без учета base (например, /surgeon-site/ru/about -> /ru/about)
const pathWithoutBase = currentPath.replace(base, '/');

// Убираем язык из пути (например, /ru/about -> /about)
let pathWithoutLocale = pathWithoutBase.replace(/^\/(ru|en)/, '');

// Если путь пустой, ставим слэш
if (pathWithoutLocale === '') {
    pathWithoutLocale = '/';
} else if (!pathWithoutLocale.startsWith('/')) {
    pathWithoutLocale = '/' + pathWithoutLocale;
}

// Собираем финальные ссылки вручную
const ruUrl = `${basePrefix}/ru${pathWithoutLocale}`;
const enUrl = `${basePrefix}/en${pathWithoutLocale}`;
---

<div class="flex items-center gap-1">
  <a 
    href={ruUrl} 
    class:list={[
      "px-2 py-1 rounded text-sm font-medium transition",
      currentLocale === 'ru' ? 'bg-white/20 text-white' : 'text-slate-300 hover:text-white'
    ]}
  >RU</a>
  <a 
    href={enUrl} 
    class:list={[
      "px-2 py-1 rounded text-sm font-medium transition",
      currentLocale === 'en' ? 'bg-white/20 text-white' : 'text-slate-300 hover:text-white'
    ]}
  >EN</a>
</div>