---
const locale = Astro.currentLocale || 'ru';

const t = {
  ru: {
    title: 'Отзывы',
    badge: '[ ПЛЕЙСХОЛДЕР ]',
    tabs: [
      { label: 'Селфи', cat: 'selfie' },
      { label: 'Мессенджеры', cat: 'messengers' },
      { label: 'Соцсети', cat: 'social' }
    ],
  },
  en: {
    title: 'Reviews',
    badge: '[ PLACEHOLDER ]',
    tabs: [
      { label: 'Selfies', cat: 'selfie' },
      { label: 'Messengers', cat: 'messengers' },
      { label: 'Social Networks', cat: 'social' }
    ],
  }
};
const text = t[locale] || t.ru;

const reviewsData = [
  ...Array(8).fill({ cat: 'selfie', title: text.tabs[0].label }).map((item, i) => ({ ...item, id: i + 1 })),
  ...Array(8).fill({ cat: 'messengers', title: text.tabs[1].label }).map((item, i) => ({ ...item, id: i + 1 })),
  ...Array(8).fill({ cat: 'social', title: text.tabs[2].label }).map((item, i) => ({ ...item, id: i + 1 })),
];
---

<section id="reviews" class="pt-2 pb-2 scroll-mt-24">
	<div class="max-w-6xl mx-auto px-4">
		<div class="flex items-baseline gap-3 mb-6">
			<h2 class="text-3xl md:text-4xl font-bold text-slate-900">{text.title}</h2>
			<span class="text-xs md:text-sm font-mono text-slate-400 bg-slate-200 px-2 py-1 rounded">{text.badge}</span>
		</div>
		
		<div class="flex flex-wrap gap-3 mb-8">
			{text.tabs.map((tab, i) => (
				<button 
					type="button"
					data-category={tab.cat}
					class:list={[
						"reviews-tab px-5 py-2.5 rounded-lg border text-sm font-medium transition shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-400",
						i === 0 
							? "bg-slate-900 text-white border-slate-900" 
							: "bg-white text-slate-600 border-slate-300 hover:bg-slate-50"
					]}
				>
					{tab.label}
				</button>
			))}
		</div>

		<div id="reviews-track" class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 hide-scrollbar scroll-pl-1">
			{reviewsData.map((item, index) => (
				<div 
					data-category={item.cat}
					class:list={[
						"reviews-card snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(25%-0.75rem)] bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col gap-4 aspect-[9/16]",
						index < 8 ? "flex" : "hidden"
					]}
				>
					<div class="flex items-center gap-3 border-b border-slate-100 pb-4">
						<div class="w-10 h-10 rounded-full bg-slate-200 shrink-0 flex items-center justify-center text-slate-400 font-bold text-sm">
							{item.id}
						</div>
						<div>
							<p class="font-bold text-slate-800 text-sm">{item.title} #{item.id}</p>
							<p class="text-xs text-slate-500">Пациент</p>
						</div>
					</div>
					<div class="space-y-2 mt-2">
						<div class="h-2 w-full bg-slate-100 rounded"></div>
						<div class="h-2 w-11/12 bg-slate-100 rounded"></div>
						<div class="h-2 w-4/5 bg-slate-100 rounded"></div>
						<div class="h-2 w-2/3 bg-slate-100 rounded"></div>
						<div class="h-2 w-full bg-slate-100 rounded"></div>
						<div class="h-2 w-10/12 bg-slate-100 rounded"></div>
						<div class="h-2 w-4/5 bg-slate-100 rounded"></div>
					</div>
				</div>
			))}
		</div>

		<!-- Кнопки (скрыты на мобилках и планшетах) -->
		<div class="hidden lg:flex justify-center gap-4 mt-4">
			<button type="button" id="prev-reviews" class="w-12 h-12 rounded-full bg-slate-200 text-slate-800 flex items-center justify-center transition shadow-sm text-xl font-bold focus:outline-none">
				&#10094;
			</button>
			<button type="button" id="next-reviews" class="w-12 h-12 rounded-full bg-slate-200 text-slate-800 flex items-center justify-center transition shadow-sm text-xl font-bold focus:outline-none">
				&#10095;
			</button>
		</div>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll('.reviews-tab');
	const cards = document.querySelectorAll('.reviews-card');
	const track = document.getElementById('reviews-track');
	const prevBtn = document.getElementById('prev-reviews');
	const nextBtn = document.getElementById('next-reviews');

	function updateArrows() {
		if (!track || !prevBtn || !nextBtn) return;
		if (track.scrollLeft <= 5) {
			prevBtn.classList.add('opacity-30', 'cursor-default');
			prevBtn.classList.remove('hover:bg-slate-300', 'cursor-pointer');
		} else {
			prevBtn.classList.remove('opacity-30', 'cursor-default');
			prevBtn.classList.add('hover:bg-slate-300', 'cursor-pointer');
		}
		if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 5) {
			nextBtn.classList.add('opacity-30', 'cursor-default');
			nextBtn.classList.remove('hover:bg-slate-300', 'cursor-pointer');
		} else {
			nextBtn.classList.remove('opacity-30', 'cursor-default');
			nextBtn.classList.add('hover:bg-slate-300', 'cursor-pointer');
		}
	}

	tabs.forEach(tab => {
		tab.addEventListener('click', () => {
			tabs.forEach(t => {
				t.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
				t.classList.add('bg-white', 'text-slate-600', 'border-slate-300', 'hover:bg-slate-50');
			});
			tab.classList.remove('bg-white', 'text-slate-600', 'border-slate-300', 'hover:bg-slate-50');
			tab.classList.add('bg-slate-900', 'text-white', 'border-slate-900');

			const category = tab.getAttribute('data-category');
			cards.forEach(card => {
				if (card.getAttribute('data-category') === category) {
					card.classList.remove('hidden');
				} else {
					card.classList.add('hidden');
				}
			});
			if (track) {
				track.scrollLeft = 0;
				updateArrows();
			}
		});
	});

	track?.addEventListener('scroll', updateArrows);
	window.addEventListener('resize', updateArrows);
	setTimeout(updateArrows, 100);

	prevBtn?.addEventListener('click', () => {
		const firstCard = track?.querySelector('.reviews-card:not(.hidden)');
		if (firstCard) {
			const scrollAmount = firstCard.offsetWidth + 16;
			track?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
		}
	});
	nextBtn?.addEventListener('click', () => {
		const firstCard = track?.querySelector('.reviews-card:not(.hidden)');
		if (firstCard) {
			const scrollAmount = firstCard.offsetWidth + 16;
			track?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
		}
	});
</script>