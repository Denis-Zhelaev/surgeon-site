---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Lifting">
	<div class="py-6 max-w-4xl mx-auto">
		<a href="/en/services" class="inline-flex items-center text-slate-500 hover:text-slate-900 transition mb-8 text-sm font-medium">
			<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
			Back to all services
		</a>
		<h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Endoscopic Lifting</h1>
		<div class="bg-white p-6 md:p-10 rounded-2xl border border-slate-200 shadow-sm text-center">
			<div class="w-full h-64 bg-slate-100 border-2 border-dashed border-slate-300 rounded-xl flex items-center justify-center text-slate-400 font-medium mb-8">[ IMAGE PLACEHOLDER ]</div>
			<p class="text-slate-600 mb-4 text-lg">Here will be a detailed description of the procedure.</p>
			<span class="text-sm font-mono text-slate-400 bg-slate-100 px-3 py-1 rounded">[ TEXT PLACEHOLDER ]</span>
		</div>
	</div>
</BaseLayout>