---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog">
	<div class="py-6">
		<h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Blog</h1>
		<div class="bg-white p-6 md:p-10 rounded-2xl border border-slate-200 shadow-sm text-center">
			<p class="text-slate-600 mb-4 text-lg">Articles about plastic surgery, recovery, and self-care will appear here soon.</p>
			<span class="text-sm font-mono text-slate-400 bg-slate-100 px-3 py-1 rounded">[ BLOG PLACEHOLDER ]</span>
		</div>
	</div>
</BaseLayout>