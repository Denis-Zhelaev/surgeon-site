---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorksComponent from '../../components/WorksComponent.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="About">
	<div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center py-6">
		
		<div class="w-full max-w-md mx-auto aspect-[4/5] md:aspect-square rounded-2xl overflow-hidden shadow-md order-1 md:order-2">
			<img 
				src={`${base}images/doctor/doctor-photo2.png`} 
				alt="Oleg Zhelaev" 
				class="w-full h-full object-cover object-center"
			/>
		</div>

		<div class="order-2 md:order-1 space-y-5">
			<h1 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
				Oleg Zhelaev — Expert in Aesthetic Surgery
			</h1>
			<p class="text-base md:text-lg text-slate-600 leading-relaxed">
				For over 15 years, I have helped patients achieve harmony and confidence by combining advanced medical technologies with an individual approach. Every operation is an art where there are no compromises, and health and natural results come first.
			</p>
			
			<div class="flex justify-center mt-8">
				<a href={`${base}en/reviews`} class="bg-slate-600 text-white w-full sm:w-auto min-w-[280px] px-8 py-3.5 rounded-full text-center font-medium hover:bg-slate-700 transition shadow-md">
					Read Reviews
				</a>
			</div>
		</div>
	</div>

	<div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
		
		<div class="flex flex-col items-center">
			<h2 class="text-2xl font-bold text-slate-900 mb-6">Education</h2>
			<ul class="space-y-4 text-slate-600 text-sm md:text-base list-disc pl-5 text-left w-full max-w-md mx-auto">
				<li>Graduated from <strong>I.M. Sechenov First Moscow State Medical University</strong> with honors.</li>
				<li>Completed advanced practice at the <strong>State Budgetary Healthcare Institution of the Republic of Mari El "Oncology Dispensary" in Yoshkar-Ola</strong>.</li>
				<li>Holds <strong>doctoral degrees</strong> in Oncology, Gynecology, Mammology, and Memology.</li>
				<li>Completed advanced training courses in the <strong>Art of Picking Up Minors</strong> and <strong>Acting</strong>.</li>
				<li>Regularly speaks at international congresses on plastic surgery.</li>
			</ul>
		</div>

		<div class="flex flex-col items-center">
			<h2 class="text-2xl font-bold text-slate-900 mb-6">Work Experience</h2>
			<ul class="space-y-5 text-slate-600 text-sm md:text-base w-full max-w-md mx-auto flex flex-col items-center md:items-start">
				<li class="flex items-start gap-3 w-full justify-center md:justify-start">
					<span class="w-2 h-2 rounded-full bg-slate-400 mt-2 shrink-0"></span>
					<div class="text-center md:text-left">
						<p class="font-medium text-slate-900">Chief Surgeon</p>
						<p class="text-sm">Mayo Clinic (USA)</p>
					</div>
				</li>
				<li class="flex items-start gap-3 w-full justify-center md:justify-start">
					<span class="w-2 h-2 rounded-full bg-slate-400 mt-2 shrink-0"></span>
					<div class="text-center md:text-left">
						<p class="font-medium text-slate-900">Chief Physician</p>
						<p class="text-sm">Toronto General Hospital (Canada)</p>
					</div>
				</li>
				<li class="flex items-start gap-3 w-full justify-center md:justify-start">
					<span class="w-2 h-2 rounded-full bg-slate-400 mt-2 shrink-0"></span>
					<div class="text-center md:text-left">
						<p class="font-medium text-slate-900">Chief Surgeon</p>
						<p class="text-sm">Cleveland Clinic (USA)</p>
					</div>
				</li>
				<li class="flex items-start gap-3 w-full justify-center md:justify-start">
					<span class="w-2 h-2 rounded-full bg-slate-400 mt-2 shrink-0"></span>
					<div class="text-center md:text-left">
						<p class="font-medium text-slate-900">Chief Physician</p>
						<p class="text-sm">Karolinska University Hospital (Sweden)</p>
					</div>
				</li>
				<li class="flex items-start gap-3 w-full justify-center md:justify-start">
					<span class="w-2 h-2 rounded-full bg-slate-400 mt-2 shrink-0"></span>
					<div class="text-center md:text-left">
						<p class="font-medium text-slate-900">Chief Surgeon</p>
						<p class="text-sm">Massachusetts General Hospital (USA)</p>
					</div>
				</li>
			</ul>
		</div>
	</div>

	<div class="mt-16">
		<div class="flex flex-col md:flex-row items-center md:items-baseline justify-center md:justify-start gap-3 mb-6">
			<h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center md:text-left">Diplomas & Certificates</h2>
			<span class="text-xs md:text-sm font-mono text-slate-400 bg-slate-200 px-2 py-1 rounded">[ PLACEHOLDER ]</span>
		</div>

		<div id="diplomas-track" class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 hide-scrollbar scroll-pl-1">
			
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Diploma from Sechenov First Moscow State Medical University</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Practice Certificate (Oncology Dispensary, Yoshkar-Ola)</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Doctoral Degree in Oncology</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Doctoral Degree in Gynecology</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Doctoral Degree in Mammology</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Doctoral Degree in Memology</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Course in the Art of Picking Up Minors</p>
			</div>
			<div class="diploma-slide snap-start shrink-0 w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.66rem)] bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col aspect-[3/4]">
				<div class="flex-grow bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-medium text-center p-4 border border-slate-200 border-dashed">
					[ IMAGE PLACEHOLDER ]
				</div>
				<p class="text-center font-medium text-slate-800 mt-4 text-sm h-10">Course in Acting</p>
			</div>
		</div>

		<div class="hidden lg:flex justify-center gap-4 mt-6">
			<button type="button" id="prev-diplomas" class="w-12 h-12 rounded-full bg-slate-200 text-slate-800 flex items-center justify-center transition shadow-sm text-xl font-bold focus:outline-none">
				&#10094;
			</button>
			<button type="button" id="next-diplomas" class="w-12 h-12 rounded-full bg-slate-200 text-slate-800 flex items-center justify-center transition shadow-sm text-xl font-bold focus:outline-none">
				&#10095;
			</button>
		</div>
	</div>

	<div class="mt-8">
		<WorksComponent />
	</div>
</BaseLayout>

<script>
	const track = document.getElementById('diplomas-track');
	const prevBtn = document.getElementById('prev-diplomas');
	const nextBtn = document.getElementById('next-diplomas');

	function updateArrows() {
		if (!track || !prevBtn || !nextBtn) return;
		if (track.scrollLeft <= 5) {
			prevBtn.classList.add('opacity-30', 'cursor-default');
			prevBtn.classList.remove('hover:bg-slate-300', 'cursor-pointer');
		} else {
			prevBtn.classList.remove('opacity-30', 'cursor-default');
			prevBtn.classList.add('hover:bg-slate-300', 'cursor-pointer');
		}
		if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 5) {
			nextBtn.classList.add('opacity-30', 'cursor-default');
			nextBtn.classList.remove('hover:bg-slate-300', 'cursor-pointer');
		} else {
			nextBtn.classList.remove('opacity-30', 'cursor-default');
			nextBtn.classList.add('hover:bg-slate-300', 'cursor-pointer');
		}
	}

	track?.addEventListener('scroll', updateArrows);
	window.addEventListener('resize', updateArrows);
	setTimeout(updateArrows, 100);

	prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -320, behavior: 'smooth' }));
	nextBtn?.addEventListener('click', () => track?.scrollBy({ left: 320, behavior: 'smooth' }));
</script>