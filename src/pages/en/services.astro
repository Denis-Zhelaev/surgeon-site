---
const base = import.meta.env.BASE_URL;
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  { title: 'Consultation', desc: 'Initial appointment with the surgeon. Discussion of your expectations, result modeling, and creating a plan.', img: `${base}/images/services/consultation.png`, link: `${base}/en/services/consultation` },
  { title: 'Eyelids', desc: 'Upper and lower blepharoplasty. Removal of drooping eyelids, bags, and wrinkles for a fresh look.', img: `${base}/images/services/eyelids.png`, link: `${base}/en/services/eyelids` },
  { title: 'Lifting', desc: 'Endoscopic face and neck lift. A minimally invasive method for correcting age-related changes.', img: `${base}/images/services/lifting.png`, link: `${base}/en/services/lifting` },
  { title: 'Nose', desc: 'Rhinoplasty. Correction of the shape, size, and proportions of the nose while maintaining natural breathing.', img: `${base}/images/services/nose.png`, link: `${base}/en/services/nose` }, 
  { title: 'Breast', desc: 'Augmentation, reduction, or lift. Achieving the perfect shape and volume, considering anatomy.', img: `${base}/images/services/breast.png`, link: `${base}/en/services/breast` },
  { title: 'Body', desc: 'Liposuction, abdominoplasty, arm lift. Elimination of fat deposits and body contouring.', img: `${base}/images/services/body.png`, link: `${base}/en/services/body` },
  { title: 'Face', desc: 'Cheiloplasty, otoplasty, contouring. Correction of individual facial features for ideal proportions.', img: `${base}/images/services/face.png`, link: `${base}/en/services/face` },
  { title: 'General Surgery', desc: 'Removal of skin neoplasms, scars, and other minor surgical interventions.', img: `${base}/images/services/general.png`, link: `${base}/en/services/general` },
];
---

<BaseLayout title="Services">
	<div class="py-8">
		<h1 class="text-4xl md:text-5xl font-medium text-slate-800 mb-12">Services</h1>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
			{services.map(service => (
				<a href={service.link} class="group flex flex-col h-full text-left">
					
					<div class="w-full h-48 mb-4 flex items-center justify-center">
						<img 
							src={service.img} 
							alt={service.title} 
							class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-500 ease-out"
							onerror="this.style.display='none'"
						/>
					</div>
					
					<h2 class="text-lg md:text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition">{service.title}</h2>
					
					<p class="text-slate-500 text-sm leading-relaxed mb-4 flex-grow">{service.desc}</p>
					
					<span class="text-slate-400 font-medium text-sm border-b border-transparent group-hover:border-slate-400 transition pb-1 mt-auto">
						Read More
					</span>
				</a>
			))}
		</div>
	</div>
</BaseLayout>