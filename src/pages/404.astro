---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="ru">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>404 - Страница не найдена</title>
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body class="font-sans text-gray-800 bg-gray-50 flex flex-col items-center justify-center min-h-screen p-4">
	
	<div class="text-center max-w-md mx-auto">
		<h1 class="text-7xl md:text-9xl font-bold text-slate-200 mb-4">404</h1>
		<h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">Страница не найдена</h2>
		<p class="text-slate-600 mb-8">
			Возможно, она была удалена или вы ошиблись в адресе. Но вы всегда можете вернуться на главную.
		</p>
		<a href={`${base}/ru/`} class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-medium hover:bg-slate-800 transition shadow-md">
			Вернуться на главную
		</a>
	</div>

</body>
</html>