---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Страница не найдена">
	<div class="py-20 text-center flex flex-col items-center justify-center min-h-[50vh]">
		<h1 class="text-6xl md:text-9xl font-bold text-slate-200 mb-4">404</h1>
		<h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">Страница не найдена</h2>
		<p class="text-slate-600 mb-8 max-w-md mx-auto">
			Возможно, она была удалена или вы ошиблись в адресе. Но вы всегда можете вернуться на главную.
		</p>
		<a href={`${base}/ru/`} class="bg-slate-900 text-white px-8 py-3 rounded-lg font-medium hover:bg-slate-800 transition shadow-md">
			Вернуться на главную
		</a>
	</div>
</BaseLayout>