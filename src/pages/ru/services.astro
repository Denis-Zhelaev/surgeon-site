---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const services = [
  { title: 'Консультация', desc: 'Первичный прием хирурга. Обсуждение ваших ожиданий, моделирование результата и составление индивидуального плана операции.', img: `${base}images/services/consultation.png`, link: `${base}ru/services/consultation` },
  { title: 'Веки', desc: 'Блефаропластика верхних и нижних век. Устранение нависших век, мешков и морщин для возвращения свежего и открытого взгляда.', img: `${base}images/services/eyelids.png`, link: `${base}ru/services/eyelids` },
  { title: 'Лифтинг', desc: 'Эндоскопическая подтяжка лица и шеи. Малоинвазивный метод коррекции возрастных изменений и возвращения четкого овала лица.', img: `${base}images/services/lifting.png`, link: `${base}ru/services/lifting` },
  { title: 'Нос', desc: 'Ринопластика. Коррекция формы, размера и пропорций носа с сохранением естественного дыхания и гармонии черт лица.', img: `${base}images/services/nose.png`, link: `${base}ru/services/nose` },
  { title: 'Грудь', desc: 'Увеличение, уменьшение или подтяжка груди. Достижение идеальной формы и объема с учетом анатомических особенностей.', img: `${base}images/services/breast.png`, link: `${base}ru/services/breast` },
  { title: 'Тело', desc: 'Липосакция, абдоминопластика, подтяжка рук. Устранение локальных жировых отложений и моделирование контуров тела.', img: `${base}images/services/body.png`, link: `${base}ru/services/body` },
  { title: 'Лицо', desc: 'Хейлопластика, отопластика, контурная пластика. Коррекция отдельных черт лица для достижения идеальных пропорций.', img: `${base}images/services/face.png`, link: `${base}ru/services/face` },
  { title: 'Общая хирургия', desc: 'Удаление новообразований кожи, рубцов и другие малые хирургические вмешательства. Безопасность и эстетичный результат.', img: `${base}images/services/general.png`, link: `${base}ru/services/general` },
];
---

<BaseLayout title="Услуги">
	<div class="py-8">
		<h1 class="text-4xl md:text-5xl font-medium text-slate-800 mb-12">Услуги</h1>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
			{services.map(service => (
				<a href={service.link} class="group flex flex-col h-full text-left">
					
					<div class="w-full h-48 mb-4 flex items-center justify-center">
						<img 
							src={service.img} 
							alt={service.title} 
							class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-500 ease-out"
							onerror="this.style.display='none'"
						/>
					</div>
					
					<h2 class="text-lg md:text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition">{service.title}</h2>
					
					<p class="text-slate-500 text-sm leading-relaxed mb-4 flex-grow">{service.desc}</p>
					
					<span class="text-slate-400 font-medium text-sm border-b border-transparent group-hover:border-slate-400 transition pb-1 mt-auto">
						Узнать больше
					</span>
				</a>
			))}
		</div>
	</div>
</BaseLayout>